PORT=3001
JWT_SECRET=change-me-in-production
FRONTEND_URL=http://localhost:3000

# Public site used in confirmation and reset links (no trailing path).
APP_URL=http://localhost:3000

# Production email. Leave unset in development; messages are logged instead.
# The app still boots without these. The send endpoints return 503 until they are set.
# RESEND_API_KEY=
# EMAIL_FROM=Prysmic <notes@prysmic.me>

# Optional caps for verification resend and password reset (per address, per IP, window ms).
# AUTH_RATE_LIMIT_ACCOUNT=5
# AUTH_RATE_LIMIT_IP=20
# AUTH_RATE_LIMIT_WINDOW_MS=900000

# --- Database (use ONE style) ---
# Managed Postgres (Railway, Render, etc.) — paste the full URL from the host dashboard.
# If the DB password contains @, #, or other special characters, URL-encode them (@ → %40).
DATABASE_URL=postgresql://user:pass@your-db-hostname.region.provider.com:5432/dbname
DB_SSL=true

# Local / Docker Compose without DATABASE_URL (host "db" when RUNNING_IN_DOCKER=true)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USERNAME=postgres
# DB_PASSWORD=password
# DB_NAME=ai_notes
# RUNNING_IN_DOCKER=true
